              "value": "60",
              "label": {
                "en": "60 minutes",
                "fr": "60 minutes",
                "de": "60 Minuten",
                "es": "60 minutos"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "minutes",
          "type": "number",
          "label": {
            "en": "Minutes without the broker",
            "fr": "Minutes sans le broker",
            "de": "Minuten ohne den Broker",
            "es": "Minutos sin el broker"
          }
        },
        {
          "key": "broker",
          "type": "string",
          "label": {
            "en": "Broker name",
            "fr": "Nom du broker",
            "de": "Name des Brokers",
            "es": "Nombre del broker"
          }
        }

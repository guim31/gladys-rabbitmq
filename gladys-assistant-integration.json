{
  "manifest_version": 1,
  "type": "device",
  "name": "RabbitMQ",
  "description": {
    "en": "The health of your RabbitMQ broker in Gladys: queues, messages, consumers, alarms, outages.",
    "fr": "La santé de votre broker RabbitMQ dans Gladys : files, messages, consommateurs, alarmes, pannes.",
    "de": "Der Zustand deines RabbitMQ-Brokers in Gladys: Queues, Nachrichten, Consumer, Alarme, Ausfälle.",
    "es": "La salud de su broker RabbitMQ en Gladys: colas, mensajes, consumidores, alarmas, caídas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-rabbitmq:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-rabbitmq/main/cover.png",
  "categories": ["network"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect RabbitMQ",
        "fr": "Connecter RabbitMQ",
        "de": "RabbitMQ verbinden",
        "es": "Conectar RabbitMQ"
      },
      "description": {
        "en": "The integration reads the management API of RabbitMQ every 30 seconds. It never changes anything. A user with the monitoring tag is enough: rabbitmqctl set_user_tags <user> monitoring.",
        "fr": "L'intégration lit l'API de gestion de RabbitMQ toutes les 30 secondes. Elle ne modifie jamais rien. Un utilisateur avec le tag monitoring suffit : rabbitmqctl set_user_tags <utilisateur> monitoring.",
        "de": "Die Integration liest alle 30 Sekunden die Management-API von RabbitMQ und ändert nie etwas. Ein Benutzer mit dem Tag monitoring genügt: rabbitmqctl set_user_tags <Benutzer> monitoring.",
        "es": "La integración lee la API de gestión de RabbitMQ cada 30 segundos. Nunca modifica nada. Basta con un usuario con la etiqueta monitoring: rabbitmqctl set_user_tags <usuario> monitoring."
      },
      "links": [
        {
          "url": "https://www.rabbitmq.com/docs/management",
          "label": {
            "en": "The management plugin of RabbitMQ",
            "fr": "Le plugin de gestion de RabbitMQ",
            "de": "Das Management-Plugin von RabbitMQ",
            "es": "El plugin de gestión de RabbitMQ"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "required": true,
      "label": {
        "en": "Address of RabbitMQ",
        "fr": "Adresse de RabbitMQ",
        "de": "Adresse von RabbitMQ",
        "es": "Dirección de RabbitMQ"
      },
      "description": {
        "en": "The address of the management interface, port 15672 by default (http:// or https://).",
        "fr": "L'adresse de l'interface de gestion, port 15672 par défaut (http:// ou https://).",
        "de": "Die Adresse der Management-Oberfläche, standardmäßig Port 15672 (http:// oder https://).",
        "es": "La dirección de la interfaz de gestión, puerto 15672 por defecto (http:// o https://)."
      },
      "placeholder": {
        "en": "e.g. http://rabbitmq.local:15672",
        "fr": "ex. http://rabbitmq.local:15672",
        "de": "z. B. http://rabbitmq.local:15672",
        "es": "p. ej. http://rabbitmq.local:15672"
      }
    },
    {
      "key": "username",
      "type": "string",
      "required": true,
      "label": {
        "en": "User",
        "fr": "Utilisateur",
        "de": "Benutzer",
        "es": "Usuario"
      },
      "description": {
        "en": "Read access is enough: a user with the monitoring tag, no administrator.",
        "fr": "Un accès en lecture suffit : un utilisateur avec le tag monitoring, pas un administrateur.",
        "de": "Lesezugriff genügt: ein Benutzer mit dem Tag monitoring, kein Administrator.",
        "es": "Basta con acceso de lectura: un usuario con la etiqueta monitoring, no un administrador."
      }
    },
    {
      "key": "password",
      "type": "secret",
      "required": true,
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      }
    },
    {
      "key": "tls_insecure",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Accept a self-signed certificate",
        "fr": "Accepter un certificat auto-signé",
        "de": "Selbstsigniertes Zertifikat akzeptieren",
        "es": "Aceptar un certificado autofirmado"
      },
      "description": {
        "en": "https:// only: the certificate of RabbitMQ is then not checked.",
        "fr": "https:// seulement : le certificat de RabbitMQ n'est alors pas vérifié.",
        "de": "Nur https://: Das Zertifikat von RabbitMQ wird dann nicht geprüft.",
        "es": "Solo https://: el certificado de RabbitMQ no se comprueba."
      }
    },
    {
      "key": "queues",
      "type": "string",
      "label": {
        "en": "Queues to follow",
        "fr": "Files à suivre",
        "de": "Zu beobachtende Queues",
        "es": "Colas que seguir"
      },
      "description": {
        "en": "Separated by commas, 20 at most: each one becomes a device (messages, consumers). Write name for the virtual host /, vhost/name for another one. The user needs a permission on that virtual host.",
        "fr": "Séparées par des virgules, 20 au plus : chacune devient un appareil (messages, consommateurs). Écrivez nom pour l'hôte virtuel /, vhost/nom pour un autre. L'utilisateur doit avoir une permission sur cet hôte virtuel.",
        "de": "Durch Kommas getrennt, höchstens 20: Jede wird ein Gerät (Nachrichten, Consumer). Schreibe Name für den virtuellen Host /, vhost/Name für einen anderen. Der Benutzer braucht eine Berechtigung für diesen virtuellen Host.",
        "es": "Separadas por comas, 20 como máximo: cada una se convierte en un dispositivo (mensajes, consumidores). Escriba nombre para el host virtual /, vhost/nombre para otro. El usuario necesita un permiso en ese host virtual."
      },
      "placeholder": {
        "en": "e.g. zigbee, iot/sensors",
        "fr": "ex. zigbee, iot/capteurs",
        "de": "z. B. zigbee, iot/sensoren",
        "es": "p. ej. zigbee, iot/sensores"
      }
    },
    {
      "key": "language",
      "type": "select",
      "default": "fr",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Feature names of the devices when they are added, scene sentences and action messages.",
        "fr": "Noms des fonctionnalités des appareils à leur ajout, phrases des scènes et messages des actions.",
        "de": "Namen der Funktionen der Geräte beim Hinzufügen, Szenen-Sätze und Meldungen der Aktionen.",
        "es": "Nombres de las funciones de los dispositivos al añadirlos, frases de escenas y mensajes de las acciones."
      },
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "check_connection",
      "timeout_seconds": 30,
      "label": {
        "en": "Check the connection",
        "fr": "Vérifier la connexion",
        "de": "Verbindung prüfen",
        "es": "Comprobar la conexión"
      },
      "description": {
        "en": "Reads RabbitMQ now: version, key numbers, alarms in progress and followed queues.",
        "fr": "Lit RabbitMQ tout de suite : version, chiffres clés, alarmes en cours et files suivies.",
        "de": "Liest RabbitMQ sofort: Version, Kennzahlen, aktive Alarme und beobachtete Queues.",
        "es": "Lee RabbitMQ ahora mismo: versión, cifras clave, alarmas activas y colas seguidas."
      }
    }
  ],
  "scene_triggers": [
    {
      "key": "broker_unreachable",
      "label": {
        "en": "RabbitMQ: broker unreachable",
        "fr": "RabbitMQ : broker injoignable",
        "de": "RabbitMQ: Broker nicht erreichbar",
        "es": "RabbitMQ: broker inaccesible"
      },
      "description": {
        "en": "The management API has not answered for the chosen time. A restart of a few seconds fires nothing.",
        "fr": "L'API de gestion ne répond plus depuis la durée choisie. Un redémarrage de quelques secondes ne déclenche rien.",
        "de": "Die Management-API antwortet seit der gewählten Dauer nicht. Ein Neustart von wenigen Sekunden löst nichts aus.",
        "es": "La API de gestión no responde desde hace el tiempo elegido. Un reinicio de unos segundos no activa nada."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Broker",
            "fr": "Broker",
            "de": "Broker",
            "es": "Broker"
          }
        },
        {
          "key": "after_minutes",
          "type": "select",
          "required": true,
          "default": "5",
          "label": {
            "en": "Unreachable for",
            "fr": "Injoignable depuis",
            "de": "Nicht erreichbar seit",
            "es": "Inaccesible desde hace"

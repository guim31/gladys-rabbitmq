    {
      "key": "broker_back",
      "label": {
        "en": "RabbitMQ: broker back",
        "fr": "RabbitMQ : broker revenu",
        "de": "RabbitMQ: Broker wieder da",
        "es": "RabbitMQ: broker de vuelta"
      },
      "description": {
        "en": "The management API answers again after an outage of at least one minute.",
        "fr": "L'API de gestion répond de nouveau après une coupure d'au moins une minute.",
        "de": "Die Management-API antwortet wieder nach einem Ausfall von mindestens einer Minute.",
        "es": "La API de gestión vuelve a responder tras una caída de al menos un minuto."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Broker",
            "fr": "Broker",
